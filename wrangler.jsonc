{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "accent",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-11",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "UPLOADS",
			"id": "855745592a3843288076c7f65c35f716"
		}
	],
	"browser": {
		"binding": "BROWSER"
	}
}
