{
	"name": "accent",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint src scripts",
		"check:route-auth": "node scripts/check-route-auth.mjs",
		"security:poc-reruns": "node scripts/security-poc-reruns.mjs",
		"security:scrub": "node scripts/scrub-stored-html.mjs",
		"security:preflight": "node scripts/predeploy-check.mjs",
		"sweep:work-sessions": "node scripts/close-stale-work-sessions.mjs",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"verify": "npm run lint && npx tsc --noEmit && npm run test:run",
		"build:workers": "node scripts/patch-opennext-windows.mjs && npx @opennextjs/cloudflare build",
		"deploy:workers": "npm run build:workers && npx wrangler deploy",
		"preview:workers": "npm run build:workers && npx @opennextjs/cloudflare preview",
		"build:prod": "cross-env NODE_ENV=production next build",
		"prepare": "husky",
		"format": "prettier --write .",
		"migrate": "knex migrate:latest",
		"migrate:status": "knex migrate:status",
		"migrate:make": "knex migrate:make",
		"migrate:rollback": "knex migrate:rollback",
		"migrate:prod": "cross-env NODE_ENV=production knex migrate:latest",
		"migrate:prod:status": "cross-env NODE_ENV=production knex migrate:status",
		"migrate:prod:rollback": "cross-env NODE_ENV=production knex migrate:rollback",
		"seed": "knex seed:run",
		"seed:dev": "knex seed:run",
		"seed:make": "knex seed:make"
	},
	"lint-staged": {
		"**/*.{js,jsx,ts,tsx,json,css,md}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@babel/parser": "^7.28.5",
		"@cf-wasm/photon": "^0.4.0",
		"@cloudflare/puppeteer": "^1.4.0",
		"@headlessui/react": "^2.2.9",
		"@heroicons/react": "^2.2.0",
		"@opennextjs/cloudflare": "^1.20.10",
		"@radix-ui/react-avatar": "^1.1.10",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-tabs": "^1.1.13",
		"@radix-ui/react-toast": "^1.2.15",
		"@react-pdf/renderer": "^4.3.1",
		"@tanstack/react-form": "^1.33.0",
		"@tanstack/react-query": "^5.101.2",
		"@tanstack/react-table": "^8.21.3",
		"@tiptap/extension-list-keymap": "^3.24.0",
		"@tiptap/react": "^3.24.0",
		"@tiptap/starter-kit": "^3.24.0",
		"acorn": "^8.15.0",
		"bcryptjs": "^3.0.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"decimal.js": "^10.6.0",
		"docxtemplater": "^3.29.0",
		"dompurify": "^3.4.16",
		"dotenv": "^17.2.3",
		"exceljs": "^4.4.0",
		"html2canvas": "^1.4.1",
		"jspdf": "^4.0.0",
		"knex": "^3.3.0",
		"lucide-react": "^0.544.0",
		"mysql2": "^3.23.1",
		"next": "^16.3.8",
		"papaparse": "^5.5.3",
		"pizzip": "^3.1.6",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-hot-toast": "^2.6.0",
		"recharts": "^2.12.0",
		"sanitize-html": "^2.17.7",
		"swr": "^2.4.1",
		"tailwind-merge": "^3.3.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^24.13.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/sanitize-html": "^2.16.1",
		"@vitejs/plugin-react": "^6.0.2",
		"cross-env": "^10.1.0",
		"eslint": "^9",
		"eslint-config-next": "^16.3.8",
		"husky": "^9.1.7",
		"jsdom": "^29.1.1",
		"lint-staged": "^17.0.5",
		"prettier": "^3.8.3",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vitest": "^4.1.7"
	},
	"allowScripts": {
		"@tailwindcss/oxide@4.1.13": true,
		"bcrypt@6.0.0": true,
		"core-js@3.46.0": true,
		"sharp@0.34.5": true,
		"sharp@0.33.5": true,
		"puppeteer@25.1.0": true,
		"unrs-resolver@1.11.1": true
	},
	"engines": {
		"node": "24.x"
	}
}
